# Zertifikat fuer zot. Der Name "zot" wird im Cluster verwendet,
# localhost und 127.0.0.1 vom Rechner aus.
[req]
distinguished_name = dn
prompt = no

[dn]
CN = zot

[server]
subjectAltName = DNS:zot,DNS:localhost,IP:127.0.0.1
keyUsage = digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth
